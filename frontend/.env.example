# Default - Full Application (Wallet + E-Commerce)
VITE_APP_MODE=full
VITE_ENABLE_WALLET=true
VITE_ENABLE_ECOMMERCE=true

# API Configuration
VITE_WALLET_API_URL=http://localhost:3001/api/wallet
VITE_ECOMMERCE_API_URL=http://localhost:3002/api/ecommerce
VITE_AUTH_API_URL=http://localhost:3000/api/auth

# Cross-Module Configuration
# Allow e-commerce access to wallet balance
VITE_CROSS_MODULE_WALLET=true
# Automatically sync wallet balance to e-commerce profile
VITE_AUTO_SYNC_BALANCE=true
# Require wallet connection before checkout
VITE_REQUIRE_WALLET_CHECKOUT=false

# UI Configuration
VITE_SHOW_WALLET_WIDGET=true

# Backend Configuration
VITE_BACKEND_URL=http://localhost:5000
VITE_BLOCKCHAIN_RPC=http://localhost:26657

# Governance Configuration
VITE_API_BASE=http://localhost:4000
VITE_CHAIN_ID=mallchain-1
VITE_CHAIN_RPC=http://localhost:26657
VITE_CHAIN_REST=http://localhost:1317
VITE_GOV_DEPOSIT_DENOM=umal
VITE_GOV_DEFAULT_DEPOSIT=1000000
