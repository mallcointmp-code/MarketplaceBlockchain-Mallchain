# E-Commerce Module ONLY
# For running e-commerce as a standalone application
VITE_APP_MODE=ecommerce
VITE_ENABLE_WALLET=false
VITE_ENABLE_ECOMMERCE=true
VITE_ECOMMERCE_API_URL=http://localhost:3002/api/ecommerce
VITE_AUTH_API_URL=http://localhost:3000/api/auth

# Optional: Still connect to wallet for balance display (microservices)
VITE_CROSS_MODULE_WALLET=false
VITE_WALLET_API_URL=http://localhost:3001/api/wallet
