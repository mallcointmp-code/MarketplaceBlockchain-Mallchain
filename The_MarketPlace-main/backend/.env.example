# The Market Place - backend environment example
# Copy this file to `.env` and fill values for your environment.

# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/marketplace

# Redis (used for queues, OTP, dedupe). A single URL or host/port may be used.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT / crypto secrets
JWT_SECRET=change_this_jwt_secret
CRYPTO_SECRET=change_this_crypto_secret

# Application domain / frontend
FRONTEND_BASE=https://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
APP_DOMAIN=localhost

# QR signing
QR_SIGN_SECRET=change_this_qr_sign_secret

# OTP / 2FA
OTP_TTL=300                      # seconds
OTP_RATE_LIMIT_SECONDS=60        # rate limit for requesting OTPs
TWOFA_WINDOW=300                 # seconds window to mark 2FA verified
WITHDRAW_2FA_THRESHOLD=10000     # amount threshold requiring 2FA (example)
WALLET_2FA_LIMIT=10000

# Email (SMTP) - used by otp/emailService/notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="The Market Place <no-reply@example.com>"

# Twilio / SMS / WhatsApp
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+12025550123
TWILIO_PHONE=+12025550123
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Push (VAPID keys for web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payment providers (fill as needed)
# Stripe
STRIPE_SECRET_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# M-Pesa / Daraja placeholders (implement mpesaService to use)
MPESA_TOKEN=
MPESA_SHORTCODE=
MPESA_CALLBACK=
STK_CALLBACK_URL=

# AWS S3 (uploads)
USE_S3=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google / Maps / other APIs
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# Mailchimp (marketing)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Slack / Telegram (optional notifications)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# Web3 / Ethereum settings (if using contracts)
RPC_URL=http://127.0.0.1:8545
ADMIN_PK=
DEPLOYER_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
MALLCOIN_ADDRESS=
MALLPOINTS_ADDRESS=
MALLCOIN_ABI_PATH=
MALLPOINTS_ABI_PATH=
ETHERSCAN_API_KEY=
GANACHE_MNEMONIC=
BACKEND_MINTER_ADDRESS=

# Misc / admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_this_password

# Logging / monitoring
# SENTRY_DSN=

# Example limits / worker tuning
AD_WORKER_CONCURRENCY=5

# Notes:
# - Do NOT commit real secrets. Use a secrets manager or environment variables in production.
# - Some features (MPESA, Stripe, Twilio, S3) require implementing provider-specific service code
#   and setting the corresponding env vars above.## Example environment variables for The Market Place backend
## Copy this to `backend/.env` and fill real values. Do NOT commit secrets.

# Server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/marketplace
NODE_ENV=development

# Crypto and JWT (required)
# Set a strong passphrase for CRYPTO_SECRET (kept out of repo)
CRYPTO_SECRET=replace_with_strong_passphrase
JWT_SECRET=replace_with_long_random_secret

# Ethereum keys (keep private)
DEPLOYER_PRIVATE_KEY=replace_with_private_key
TREASURY_PRIVATE_KEY=replace_with_private_key_or_empty

# Contracts
MALLCOIN_ABI_PATH=./artifacts/contracts/Mallcoin.sol/Mallcoin.json
MALLPOINTS_ABI_PATH=./artifacts/contracts/Mallpoints.sol/Mallpoints.json
MALLCOIN_ADDRESS=0x...
MALLPOINTS_ADDRESS=0x...

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_FROM="The Market Place <no-reply@themarketplace.com>"

# AWS / S3 (optional)
USE_S3=false
AWS_S3_BUCKET=your-bucket
AWS_REGION=your-region
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Third-party services
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number

# Other
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT_SECONDS=60

# Blockchain Integration
BLOCKCHAIN_API_URL=http://localhost:4000
BLOCKCHAIN_RPC_URL=http://localhost:26657
BLOCKCHAIN_REST_URL=http://localhost:1317
ENABLE_BLOCKCHAIN_SYNC=true

# Notes:
# - Do NOT store real secrets in the repository. Keep `backend/.env` out of source control.